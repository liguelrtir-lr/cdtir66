<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Comité Départemental de Tir 66 — Pyrénées-Orientales</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Barlow:wght@300;400;500;600&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy:   #080e28;
    --red:    #c0272d;
    --gold:   #d4a843;
    --cream:  #f5f0e8;
    --white:  #ffffff;
    --gray:   #6b7280;
    --light:  #f0ede7;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--white);
    color: var(--navy);
    overflow-x: hidden;
  }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--navy); }
  ::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 3px; }

  /* ── NAVBAR ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px;
    height: 70px;
    background: rgba(8,14,40,0.97);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(212,168,67,0.2);
  }
  .nav-brand {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none;
  }
  .nav-target {
    width: 36px; height: 36px;
    position: relative; flex-shrink: 0;
  }
  .nav-target img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .nav-brand-text {
    color: var(--white);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }
  .nav-brand-text span {
    display: block;
    color: var(--gold);
    font-size: 1.1rem;
    font-weight: 700;
  }
  .nav-links {
    display: flex; gap: 0; list-style: none;
  }
  .nav-links a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 14px;
    transition: color 0.2s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute; bottom: 0; left: 14px; right: 14px; height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.2s;
  }
  .nav-links a:hover { color: var(--white); }
  .nav-links a:hover::after { transform: scaleX(1); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    background: linear-gradient(150deg, #0d1535 0%, #1a2660 50%, #2a1018 100%);
    position: relative;
    display: flex; align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 70% 50%, rgba(192,39,45,0.22) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 10% 80%, rgba(212,168,67,0.12) 0%, transparent 60%);
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
  }
  .hero-crosshair {
    position: absolute; right: 5%; top: 50%;
    transform: translateY(-50%);
    width: min(52vw, 600px); height: min(52vw, 600px);
    opacity: 0.35;
    animation: rotateSlow 30s linear infinite;
  }
  @keyframes rotateSlow {
    from { transform: translateY(-50%) rotate(0deg); }
    to   { transform: translateY(-50%) rotate(360deg); }
  }
  .hero-content {
    position: relative; z-index: 2;
    padding: 120px 80px 80px;
    max-width: 700px;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(212,168,67,0.15);
    border: 1px solid rgba(212,168,67,0.4);
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 2px;
    margin-bottom: 28px;
    animation: fadeUp 0.8s ease both;
  }
  .hero-badge::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--gold);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 900;
    color: var(--white);
    line-height: 1.05;
    margin-bottom: 8px;
    animation: fadeUp 0.8s 0.1s ease both;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--red);
    display: block;
  }
  .hero-dept {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 24px;
    animation: fadeUp 0.8s 0.2s ease both;
  }
  .hero p {
    color: rgba(255,255,255,0.6);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 40px;
    animation: fadeUp 0.8s 0.3s ease both;
  }
  .hero-ctas {
    display: flex; gap: 16px; flex-wrap: wrap;
    animation: fadeUp 0.8s 0.4s ease both;
  }
  .btn-primary {
    background: var(--red);
    color: var(--white);
    padding: 14px 32px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: none; cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    display: inline-block;
  }
  .btn-primary:hover { background: #a01f24; transform: translateY(-2px); }
  .btn-outline {
    border: 1px solid rgba(212,168,67,0.5);
    color: var(--gold);
    padding: 14px 32px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
    display: inline-block;
  }
  .btn-outline:hover { border-color: var(--gold); color: var(--white); transform: translateY(-2px); }

  .hero-stats {
    position: absolute; bottom: 40px; left: 80px; right: 80px;
    display: flex; gap: 40px;
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 28px;
    animation: fadeUp 0.8s 0.5s ease both;
  }
  .hero-stat { color: var(--white); }
  .hero-stat .val {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
  }
  .hero-stat .lbl {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-top: 4px;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── SECTION COMMON ── */
  section { padding: 90px 80px; }
  .section-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 8px;
    display: flex; align-items: center; gap: 10px;
  }
  .section-label::before {
    content: '';
    width: 24px; height: 2px;
    background: var(--red);
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 900;
    color: var(--navy);
    line-height: 1.1;
    margin-bottom: 40px;
  }
  .section-title span { color: var(--red); }

  /* ── ACTUALITÉS ── */
  #actualites { background: var(--white); }
  .news-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 24px;
  }
  .news-card {
    background: var(--white);
    position: relative;
    overflow: hidden;
    transition: transform 0.3s;
    cursor: pointer;
  }
  .news-card:hover { transform: translateY(-4px); }
  .news-card-img {
    width: 100%; aspect-ratio: 16/9;
    background: var(--navy);
    position: relative;
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .news-card-img .icon-bg {
    font-size: 3rem;
    opacity: 0.3;
  }
  .news-card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .news-card-img.red-bg   { background: linear-gradient(135deg, #c0272d, #7a0d10); }
  .news-card-img.navy-bg  { background: linear-gradient(135deg, #080e28, #1a2560); }
  .news-card-img.gold-bg  { background: linear-gradient(135deg, #d4a843, #9a7320); }
  .news-tag {
    position: absolute; top: 12px; left: 12px;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 10px;
  }
  .news-body { padding: 20px; }
  .news-date {
    font-size: 0.72rem;
    color: var(--gray);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .news-body h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 8px;
    color: var(--navy);
  }
  .news-card.featured .news-body h3 { font-size: 1.4rem; }
  .news-body img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    margin: 10px 0;
  }
  .news-body p {
    font-size: 0.85rem;
    color: var(--gray);
    line-height: 1.6;
  }
  .news-more {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
    text-decoration: none;
    transition: gap 0.2s;
  }
  .news-more:hover { gap: 10px; }

  /* ── CALENDRIER ── */
  #calendrier { background: #f4f6fb; }
  #calendrier .section-title { color: var(--navy); }
  #calendrier .section-label { color: var(--red); }
  #calendrier .section-label::before { background: var(--red); }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .cal-item {
    display: flex; gap: 20px; align-items: flex-start;
    background: var(--white);
    border: 1px solid rgba(8,14,40,0.08);
    padding: 20px 24px;
    transition: background 0.2s, border-color 0.2s;
    cursor: pointer;
  }
  .cal-item:hover {
    background: rgba(192,39,45,0.05);
    border-color: rgba(192,39,45,0.3);
  }
  .cal-date {
    text-align: center; flex-shrink: 0;
    background: var(--red);
    padding: 8px 12px;
    min-width: 52px;
  }
  .cal-date .day {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1;
  }
  .cal-date .month {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }
  .cal-info h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }
  .cal-info p {
    font-size: 0.78rem;
    color: var(--gray);
    line-height: 1.5;
  }
  .cal-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 1px;
    margin-top: 6px;
    display: inline-block;
  }
  .badge-issf { background: rgba(212,168,67,0.2); color: #8a6215; }
  .badge-tar  { background: rgba(100,180,255,0.2); color: #0b5f99; }
  .badge-edt  { background: rgba(100,255,150,0.2); color: #157a45; }
  .badge-mlaic{ background: rgba(255,180,100,0.2); color: #a35a0a; }

  /* ── RÉSULTATS ── */
  #resultats { background: var(--white); }
  .results-tabs {
    display: flex; gap: 4px;
    margin-bottom: 28px;
    border-bottom: 2px solid rgba(0,0,0,0.08);
    flex-wrap: wrap;
  }
  .tab-btn {
    padding: 10px 22px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none; background: none;
    color: var(--gray);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: color 0.2s;
  }
  .tab-btn.active { color: var(--red); border-bottom-color: var(--red); }
  .tab-btn:hover:not(.active) { color: var(--navy); }

  /* ── CLUBS ── */
  #clubs { background: #f4f6fb; }
  .clubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .club-card {
    background: var(--white);
    padding: 24px;
    border-left: 4px solid var(--red);
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }
  .club-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(8,14,40,0.12);
  }
  .club-initial {
    width: 48px; height: 48px;
    background: var(--navy);
    color: var(--gold);
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
  }
  .club-logo {
    width: 72px; height: 72px;
    object-fit: contain;
    margin-bottom: 12px;
    display: block;
  }
  .club-card h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--navy);
    margin-bottom: 4px;
    line-height: 1.2;
  }
  .club-card p {
    font-size: 0.78rem;
    color: var(--gray);
  }
  .club-members {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .club-num {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .club-email {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--red);
    text-decoration: none;
    word-break: break-all;
    letter-spacing: 0.02em;
  }
  .club-email:hover { text-decoration: underline; }

  /* ── GALERIE ── */
  #galerie { background: var(--white); }
  #galerie .section-title { color: var(--navy); }
  #galerie .section-label { color: var(--red); }
  #galerie .section-label::before { background: var(--red); }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    gap: 12px;
  }
  .gallery-item {
    aspect-ratio: 4/3;
    background: #e8ecf5;
    border: 1px solid rgba(8,14,40,0.08);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .gallery-item:hover { border-color: rgba(192,39,45,0.4); }
  .gallery-item.span2 { grid-column: span 2; }
  .gallery-item .overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,14,40,0.8), transparent);
    opacity: 0;
    transition: opacity 0.3s;
    display: flex; align-items: flex-end; padding: 16px;
  }
  .gallery-item:hover .overlay { opacity: 1; }
  .overlay span {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .gallery-caption {
    text-align: center;
    margin-top: 24px;
    color: var(--gray);
    font-size: 0.82rem;
  }
  .gallery-caption a { color: var(--red); text-decoration: none; }

  .gallery-item .play-badge {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.2rem; color: var(--white);
    background: rgba(8,14,40,0.25);
    pointer-events: none;
  }
  .video-lightbox {
    display: none;
    position: fixed; inset: 0;
    background: rgba(8,14,40,0.92);
    z-index: 999;
    align-items: center; justify-content: center;
    padding: 24px;
  }
  .video-lightbox.active { display: flex; }
  .video-lightbox-inner { width: 100%; max-width: 960px; position: relative; }
  .video-lightbox-close {
    position: absolute; top: -40px; right: 0;
    background: none; border: none;
    color: var(--white); font-size: 1.6rem;
    cursor: pointer;
  }
  .video-lightbox-frame {
    position: relative; width: 100%;
    padding-bottom: 56.25%;
    background: #000;
  }
  .video-lightbox-frame iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%; border: none;
  }
  /* ── LIENS UTILES ── */
  #liens { background: #f4f6fb; }
  .liens-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .lien-card {
    display: flex; flex-direction: column;
    background: var(--white);
    padding: 24px;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: border-color 0.2s, transform 0.2s;
  }
  .lien-card:hover {
    border-bottom-color: var(--red);
    transform: translateY(-3px);
  }
  .lien-icon {
    font-size: 2rem;
    margin-bottom: 12px;
  }
  .lien-card h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 6px;
    letter-spacing: 0.03em;
  }
  .lien-card p {
    font-size: 0.78rem;
    color: var(--gray);
    line-height: 1.5;
    flex: 1;
  }
  .lien-arrow {
    margin-top: 14px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red);
  }

  /* ── FOOTER ── */
  footer {
    background: var(--navy);
    padding: 60px 80px 30px;
    border-top: 1px solid rgba(212,168,67,0.2);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-brand h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: var(--white);
    margin-bottom: 8px;
  }
  .footer-brand .dept {
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .footer-brand p {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.7;
  }
  .footer-col h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }
  .footer-col ul { list-style: none; }
  .footer-col li { margin-bottom: 8px; }
  .footer-col a {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--white); }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: 24px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px;
  }
  .footer-bottom p {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.25);
  }
  .footer-bottom span { color: var(--gold); }

  /* ── BACK TO TOP ── */
  .back-top {
    position: fixed; bottom: 28px; right: 28px;
    width: 44px; height: 44px;
    background: var(--red);
    color: var(--white);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
    cursor: pointer;
    border: none;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
    z-index: 99;
  }
  .back-top.visible { opacity: 1; pointer-events: all; }
  .back-top:hover { transform: translateY(-3px); }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    section { padding: 70px 40px; }
    .hero-content { padding: 120px 40px 80px; }
    .hero-stats { left: 40px; right: 40px; }
    .news-grid { grid-template-columns: 1fr 1fr; }
    .news-card.featured { grid-column: span 2; }
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    nav { padding: 0 20px; }
    .nav-links { display: none; }
    section { padding: 60px 24px; }
    .hero-content { padding: 100px 24px 70px; }
    .hero-stats { left: 24px; right: 24px; gap: 24px; }
    .hero-crosshair { display: none; }
    .news-grid { grid-template-columns: 1fr; }
    .news-card.featured { grid-column: 1; }
    .gallery-grid { grid-template-columns: 1fr 1fr; }
    .gallery-item.span2 { grid-column: span 1; }
    .footer-top { grid-template-columns: 1fr; gap: 28px; }
    footer { padding: 40px 24px 24px; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }

  /* ── ZONE PDF RÉSULTATS ── */
  .pdf-banner {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    background: linear-gradient(135deg, #f0f7ff, #e8f0fe);
    border: 1px solid #c5d8f8;
    border-left: 4px solid var(--navy);
    padding: 16px 20px;
    margin-bottom: 20px;
  }
  .pdf-banner-info {
    display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0;
  }
  .pdf-banner-icon { font-size: 2rem; flex-shrink: 0; }
  .pdf-banner-text strong {
    display: block;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.95rem; font-weight: 700;
    color: var(--navy); letter-spacing: 0.03em;
  }
  .pdf-banner-text span {
    font-size: 0.75rem; color: var(--gray);
  }
  .btn-pdf-dl {
    background: var(--navy); color: var(--white);
    padding: 9px 20px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; white-space: nowrap;
    transition: background 0.2s, transform 0.2s;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .btn-pdf-dl:hover { background: #1a2660; transform: translateY(-1px); }
  .btn-pdf-view {
    border: 1px solid var(--navy); color: var(--navy);
    padding: 9px 20px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; white-space: nowrap;
    transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .btn-pdf-view:hover { background: var(--navy); color: var(--white); transform: translateY(-1px); }
  .pdf-iframe-wrap {
    border: 1px solid #d0d7e8;
    margin-bottom: 28px;
    position: relative;
  }
  .pdf-iframe-wrap iframe {
    width: 100%; height: 640px; border: none; display: block;
  }
  .pdf-mobile-note {
    display: none;
    background: #f4f6fb; padding: 20px; text-align: center;
    font-size: 0.82rem; color: var(--gray);
  }
  @media (max-width: 768px) {
    .pdf-iframe-wrap iframe { display: none; }
    .pdf-mobile-note { display: block; }
    .pdf-banner { flex-direction: column; align-items: flex-start; }
  }
  .pdf-placeholder {
    background: #f4f6fb; border: 1px dashed #cdd3de;
    padding: 36px; text-align: center;
    color: var(--gray); font-size: 0.88rem;
    margin-bottom: 24px;
  }
  .pdf-placeholder .placeholder-icon { font-size: 2rem; margin-bottom: 8px; }
  .pdf-placeholder strong { display: block; color: var(--navy); margin-bottom: 4px; }
</style>
</head>
