---
layout: base.njk
---
{% set hero = collections.presentation[0].data %}

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <svg class="hero-crosshair" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
    <circle cx="200" cy="200" r="195" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.2"/>
    <circle cx="200" cy="200" r="172" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1"/>
    <circle cx="200" cy="200" r="150" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1"/>
    <circle cx="200" cy="200" r="127" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1"/>
    <circle cx="200" cy="200" r="105" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1"/>
    <circle cx="200" cy="200" r="83"  fill="none" stroke="rgba(255,255,255,0.65)" stroke-width="1.2"/>
    <circle cx="200" cy="200" r="83" fill="rgba(0,0,0,0.65)"/>
    <circle cx="200" cy="200" r="83"  stroke="rgba(255,255,255,0.75)" stroke-width="1.2" fill="none"/>
    <circle cx="200" cy="200" r="62"  stroke="rgba(255,255,255,0.75)" stroke-width="1.2" fill="none"/>
    <circle cx="200" cy="200" r="41"  stroke="rgba(255,255,255,0.85)" stroke-width="1.5" fill="none"/>
    <circle cx="200" cy="200" r="21"  stroke="rgba(255,255,255,0.9)" stroke-width="1.8" fill="none"/>
    <circle cx="200" cy="200" r="7"   stroke="rgba(255,255,255,1)"   stroke-width="2" fill="none"/>
  </svg>
  <div class="hero-content">
    <div style="margin-bottom:28px;">
      <div style="width:160px;height:160px;border-radius:50%;background:#87CEEB;
                  box-shadow:0 0 0 3px rgba(212,168,67,0.5), 0 8px 32px rgba(0,0,0,0.4);
                  overflow:hidden;position:relative;">
        <img src="logo_cdtir66_transparent.png" alt="Logo Comité Départemental de Tir 66"
             style="width:100%;height:100%;object-fit:cover;object-position:center center;display:block;">
      </div>
    </div>
    <div class="hero-badge">{{ hero.saison }}</div>
    <h1>Comité<em>de Tir</em></h1>
    <div class="hero-dept">Pyrénées-Orientales · Département 66</div>
    <p>{{ hero.intro }}</p>
    <div class="hero-ctas">
      <a href="#calendrier" class="btn-primary">Calendrier des épreuves</a>
      <a href="#clubs" class="btn-outline">Trouver un club</a>
    </div>
  </div>
  <div class="hero-stats">
    <div class="hero-stat"><div class="val">{{ hero.stat_clubs }}</div><div class="lbl">Clubs affiliés</div></div>
    <div class="hero-stat"><div class="val">{{ hero.stat_licencies }}</div><div class="lbl">Licenciés</div></div>
    <div class="hero-stat"><div class="val">{{ hero.stat_epreuves }}</div><div class="lbl">Épreuves / an</div></div>
    <div class="hero-stat"><div class="val">{{ hero.stat_disciplines }}</div><div class="lbl">Disciplines</div></div>
  </div>
</section>

<!-- ACTUALITÉS -->
<section id="actualites">
  <div class="section-label">À la une</div>
  <div class="section-title">Dernières <span>actualités</span></div>
  <div class="news-grid">
    {% for item in collections.actualites | reverse %}
    <div class="news-card{% if loop.index == 1 %} featured{% endif %}">
      <div class="news-card-img {{ item.data.couleur or 'navy-bg' }}">
        <span class="icon-bg">📰</span>
      </div>
      <div class="news-body">
        <div class="news-date">{{ item.data.date | readableDate }}</div>
        <h3>{{ item.data.title }}</h3>
        <div>{{ item.templateContent | safe }}</div>
        {% if item.data.lien %}<a href="{{ item.data.lien }}" target="_blank" class="news-more">En savoir plus →</a>{% endif %}
      </div>
    </div>
    {% else %}
    <p>Aucune actualité pour le moment.</p>
    {% endfor %}
  </div>
</section>

<!-- CALENDRIER -->
<section id="calendrier">
  <div class="section-label">Agenda</div>
  <div class="section-title">Calendrier des <span style="color:var(--gold)">épreuves</span></div>

  <div style="margin-bottom:12px;">
    <span style="font-family:'Barlow Condensed',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--red);border-bottom:2px solid var(--red);padding-bottom:4px;">Épreuves Départementales</span>
  </div>
  <div class="cal-grid" style="margin-bottom:40px;">
    {% for item in collections.calendrier %}{% if item.data.niveau == "departementale" %}
    <div class="cal-item" style="{% if item.date < buildDate %}opacity:0.5;{% endif %}">
      <div class="cal-date" style="background:{% if item.date < buildDate %}#888{% else %}var(--red){% endif %};">
        <div class="day">{{ item.data.date | dayNum }}</div>
        <div class="month">{{ item.data.date | monthAbbr }}</div>
      </div>
      <div class="cal-info">
        <h4>{{ item.data.title }}{% if item.date < buildDate %} <span style="font-size:0.75rem;color:#888">(passé)</span>{% endif %}</h4>
        <p>{{ item.data.lieu }}</p>
        {% if item.data.discipline %}<span class="cal-badge {{ item.data.discipline | disciplineBadgeClass }}">{{ item.data.discipline }}</span>{% endif %}
      </div>
    </div>
    {% endif %}{% else %}<p>Aucune épreuve départementale programmée.</p>{% endfor %}
  </div>

  <div style="margin-bottom:12px;margin-top:8px;">
    <span style="font-family:'Barlow Condensed',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--navy);border-bottom:2px solid var(--navy);padding-bottom:4px;">Épreuves Régionales — Ligue LR Tir</span>
  </div>
  <div class="cal-grid" style="margin-bottom:40px;">
    {% for item in collections.calendrier %}{% if item.data.niveau == "regionale" %}
    <div class="cal-item" style="{% if item.date < buildDate %}opacity:0.5;{% endif %}">
      <div class="cal-date" style="background:{% if item.date < buildDate %}#888{% else %}var(--navy){% endif %};">
        <div class="day">{{ item.data.date | dayNum }}</div>
        <div class="month">{{ item.data.date | monthAbbr }}</div>
      </div>
      <div class="cal-info">
        <h4>{{ item.data.title }}{% if item.date < buildDate %} <span style="font-size:0.75rem;color:#888">(passé)</span>{% endif %}</h4>
        <p>{{ item.data.lieu }}</p>
        {% if item.data.discipline %}<span class="cal-badge {{ item.data.discipline | disciplineBadgeClass }}">{{ item.data.discipline }}</span>{% endif %}
      </div>
    </div>
    {% endif %}{% else %}<p>Aucune épreuve régionale programmée.</p>{% endfor %}
  </div>

  <div style="margin-bottom:12px;margin-top:8px;">
    <span style="font-family:'Barlow Condensed',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#b8860b;border-bottom:2px solid #b8860b;padding-bottom:4px;">🏆 Championnats de France</span>
  </div>
  <div class="cal-grid" style="margin-bottom:40px;">
    {% for item in collections.calendrier %}{% if item.data.niveau == "championnat" %}
    <div class="cal-item" style="border-left:4px solid var(--gold);{% if item.date < buildDate %}opacity:0.5;{% endif %}">
      <div class="cal-date" style="background:{% if item.date < buildDate %}#888{% else %}#b8860b{% endif %};">
        <div class="day">{{ item.data.date | dayNum }}</div>
        <div class="month">{{ item.data.date | monthAbbr }}</div>
      </div>
      <div class="cal-info">
        <h4>{{ item.data.title }}{% if item.date < buildDate %} <span style="font-size:0.75rem;color:#888">(passé)</span>{% endif %}</h4>
        <p>{{ item.data.lieu }}</p>
        {% if item.data.discipline %}<span class="cal-badge {{ item.data.discipline | disciplineBadgeClass }}">{{ item.data.discipline }}</span>{% endif %}
      </div>
    </div>
    {% endif %}{% else %}<p>Aucun championnat de France programmé.</p>{% endfor %}
  </div>
</section>

<!-- RÉSULTATS -->
<section id="resultats">
  <div class="section-label">Palmarès</div>
  <div class="section-title">Résultats <span>officiels</span></div>
  <div class="results-tabs">
    <button class="tab-btn active" data-tab="issf10" onclick="switchTab('issf10')">{{ collections.resultatissf10[0].data.label }}</button>
    <button class="tab-btn" data-tab="edt" onclick="switchTab('edt')">{{ collections.resultatedt[0].data.label }}</button>
    <button class="tab-btn" data-tab="tar" onclick="switchTab('tar')">{{ collections.resultattar[0].data.label }}</button>
    <button class="tab-btn" data-tab="mlaic" onclick="switchTab('mlaic')">{{ collections.resultatmlaic[0].data.label }}</button>
  </div>

  <div id="tab-issf10"><div id="pdf-zone-issf10"></div></div>
  <div id="tab-edt" style="display:none"><div id="pdf-zone-edt"></div></div>
  <div id="tab-tar" style="display:none"><div id="pdf-zone-tar"></div></div>
  <div id="tab-mlaic" style="display:none"><div id="pdf-zone-mlaic"></div></div>
</section>

